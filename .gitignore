data/transcripts/*
!data/transcripts/.gitkeep
data/database/*
!data/database/.gitkeep

# External Binary Tools (FFmpeg, yt-dlp)
tools/ffmpeg/*
!tools/ffmpeg/.gitkeep
tools/yt-dlp/*
!tools/yt-dlp/.gitkeep

# System & OS files
.DS_Store
Thumbs.db
